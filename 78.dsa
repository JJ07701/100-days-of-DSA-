#include <stdio.h>
#include <limits.h>

int graph[101][101];
int selected[101];
int n, m;

int prim() {
    int total = 0;

    selected[1] = 1;

    for (int count = 0; count < n - 1; count++) {
        int min = INT_MAX;
        int x = 0, y = 0;

        for (int i = 1; i <= n; i++) {
            if (selected[i]) {
                for (int j = 1; j <= n; j++) {
                    if (!selected[j] && graph[i][j]) {
                        if (graph[i][j] < min) {
                            min = graph[i][j];
                            x = i;
                            y = j;
                        }
                    }
                }
            }
        }

        selected[y] = 1;
        total += graph[x][y];
    }

    return total;
}

int main() {
    scanf("%d %d", &n, &m);

    for (int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        graph[u][v] = w;
        graph[v][u] = w;
    }

    printf("%d", prim());

    return 0;
}

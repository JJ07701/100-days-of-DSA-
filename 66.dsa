#include <stdio.h>

int dfs(int node, int n, int adj[n][n], int visited[], int path[]) {
    visited[node] = 1;
    path[node] = 1;

    for (int i = 0; i < n; i++) {
        if (adj[node][i] == 1) {
            if (!visited[i]) {
                if (dfs(i, n, adj, visited, path))
                    return 1;
            }
            else if (path[i]) {
                return 1;
            }
        }
    }

    path[node] = 0;
    return 0;
}

int main() {
    int n;
    scanf("%d", &n);

    int adj[n][n];
    int visited[n], path[n];

    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        path[i] = 0;

        for (int j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            if (dfs(i, n, adj, visited, path)) {
                printf("YES");
                return 0;
            }
        }
    }

    printf("NO");
    return 0;
}

#include <stdio.h>

int hasCycle(int node, int parent, int n, int adj[n][n], int visited[]) {
    visited[node] = 1;

    for (int i = 0; i < n; i++) {
        if (adj[node][i] == 1) {
            if (!visited[i]) {
                if (hasCycle(i, node, n, adj, visited))
                    return 1;
            }
            else if (i != parent) {
                return 1;
            }
        }
    }

    return 0;
}

int main() {
    int n;
    scanf("%d", &n);

    int adj[n][n];
    int visited[n];

    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        for (int j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            if (hasCycle(i, -1, n, adj, visited)) {
                printf("YES");
                return 0;
            }
        }
    }

    printf("NO");
    return 0;
}

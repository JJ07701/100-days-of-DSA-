#include <stdio.h>

void dfs(int node, int n, int adj[n][n], int visited[]) {
    visited[node] = 1;
    printf("%d ", node);

    for (int i = 0; i < n; i++) {
        if (adj[node][i] == 1 && !visited[i]) {
            dfs(i, n, adj, visited);
        }
    }
}

int main() {
    int n, s;

    scanf("%d", &n);

    int adj[n][n];
    int visited[n];

    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        for (int j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    scanf("%d", &s);

    dfs(s, n, adj, visited);

    return 0;
}

#include <stdio.h>

int stack[100], top = -1;

void dfs(int node, int n, int adj[n][n], int visited[]) {
    visited[node] = 1;

    for (int i = 0; i < n; i++) {
        if (adj[node][i] == 1 && !visited[i]) {
            dfs(i, n, adj, visited);
        }
    }

    stack[++top] = node;
}

int main() {
    int n;
    scanf("%d", &n);

    int adj[n][n];
    int visited[n];

    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        for (int j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            dfs(i, n, adj, visited);
        }
    }

    while (top != -1) {
        printf("%d ", stack[top--]);
    }

    return 0;
}

#include <stdio.h>

int queue[100], front = 0, rear = 0;

void bfs(int n, int adj[n][n], int visited[], int s) {
    visited[s] = 1;
    queue[rear++] = s;

    while (front < rear) {
        int node = queue[front++];
        printf("%d ", node);

        for (int i = 0; i < n; i++) {
            if (adj[node][i] == 1 && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }
}

int main() {
    int n, s;
    scanf("%d", &n);

    int adj[n][n];
    int visited[n];

    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        for (int j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    scanf("%d", &s);

    bfs(n, adj, visited, s);

    return 0;
}

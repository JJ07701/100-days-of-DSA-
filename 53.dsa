#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    int hd;
    struct Node *left;
    struct Node *right;
};

struct Queue {
    struct Node* arr[1000];
    int front, rear;
};

struct Node* createNode(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->left = NULL;
    newNode->right = NULL;
    newNode->hd = 0;
    return newNode;
}

struct Node* buildTree(int arr[], int n, int i) {
    if (i >= n || arr[i] == -1)
        return NULL;

    struct Node* root = createNode(arr[i]);
    root->left = buildTree(arr, n, 2 * i + 1);
    root->right = buildTree(arr, n, 2 * i + 2);

    return root;
}

void enqueue(struct Queue* q, struct Node* node) {
    q->arr[++q->rear] = node;
}

struct Node* dequeue(struct Queue* q) {
    return q->arr[q->front++];
}

int isEmpty(struct Queue* q) {
    return q->front > q->rear;
}

void verticalOrder(struct Node* root) {
    if (root == NULL)
        return;

    int result[200][100];
    int count[200] = {0};
    int min = 100, max = 100;

    struct Queue q;
    q.front = 0;
    q.rear = -1;

    root->hd = 100;
    enqueue(&q, root);

    while (!isEmpty(&q)) {
        struct Node* temp = dequeue(&q);
        int hd = temp->hd;

        result[hd][count[hd]++] = temp->data;

        if (hd < min) min = hd;
        if (hd > max) max = hd;

        if (temp->left != NULL) {
            temp->left->hd = hd - 1;
            enqueue(&q, temp->left);
        }

        if (temp->right != NULL) {
            temp->right->hd = hd + 1;
            enqueue(&q, temp->right);
        }
    }

    for (int i = min; i <= max; i++) {
        for (int j = 0; j < count[i]; j++) {
            printf("%d ", result[i][j]);
        }
        printf("\n");
    }
}

int main() {
    int N;
    scanf("%d", &N);

    int arr[N];
    for (int i = 0; i < N; i++)
        scanf("%d", &arr[i]);

    struct Node* root = buildTree(arr, N, 0);

    verticalOrder(root);

    return 0;
}
